<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console runner: links the pure rule file from the mod and needs no game assemblies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\Rules.cs" Link="Core\Rules.cs" />
  </ItemGroup>
</Project>
